# backend/.env.example
# ----------------------------------------------------------------------
# Bu dosyayı ".env" olarak kopyalayıp gerçek SMTP bilgilerinizi girin.
# ".env" dosyası .gitignore'da olduğu için asla versiyon kontrolüne
# eklenmez — sırlarınız güvende kalır.
#
#   cp .env.example .env
#
# Gmail kullanıyorsanız SMTP_PASS'e normal şifrenizi DEĞİL, bir "Uygulama
# Şifresi" (App Password) girmeniz gerekir. Resend/Mailgun gibi
# sağlayıcılar için kendi SMTP bilgilerini kullanın.
# ----------------------------------------------------------------------

# API sunucu portu (varsayılan: 4000)
PORT=4000

# Frontend'in çalıştığı origin — üretimde CORS'u buna kilitleyin
ALLOWED_ORIGIN=http://localhost:8000

# SMTP sunucu bilgileri
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ornek@gmail.com
SMTP_PASS=uygulama-sifreniz
SMTP_FROM=orhanakyavuz.com <ornek@gmail.com>

# İletişim formu mesajlarının gönderileceği adres (genellikle SMTP_USER ile aynı)
CONTACT_TO_EMAIL=ornek@gmail.com
