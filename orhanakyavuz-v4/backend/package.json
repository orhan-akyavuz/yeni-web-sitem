{
  "name": "orhanakyavuz-backend",
  "version": "1.0.0",
  "description": "orhanakyavuz.com için Express + node:sqlite tabanlı gerçek API sunucusu (makaleler, kategoriler, etiketler, arama, iletişim, bülten)",
  "type": "module",
  "main": "server.js",
  "scripts": {
